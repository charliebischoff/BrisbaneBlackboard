{
  "name": "playbook-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run check:courtboard && npm run check:routegeometry && npm run check:stores",
    "check:courtboard": "esbuild --bundle --platform=node --format=esm tools/courtBoard.check.ts --outfile=node_modules/.cache/courtBoard.check.mjs && node node_modules/.cache/courtBoard.check.mjs",
    "check:routegeometry": "esbuild --bundle --platform=node --format=esm tools/routeGeometry.check.ts --outfile=node_modules/.cache/routeGeometry.check.mjs && node node_modules/.cache/routeGeometry.check.mjs",
    "check:stores": "esbuild --bundle --platform=node --format=esm tools/stores.check.ts --outfile=node_modules/.cache/stores.check.mjs && node node_modules/.cache/stores.check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "konva": "^9.3.6",
    "framer-motion": "^11.3.19",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "workbox-window": "^7.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-plugin-pwa": "^0.20.1"
  }
}
